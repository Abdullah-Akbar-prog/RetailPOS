<Window x:Class="RetailPOS.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Details"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="ProductTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="White"
            Margin="18"
            Padding="24"
            CornerRadius="14"
            BorderBrush="#E5EAF2"
            BorderThickness="1">

        <StackPanel>
            <TextBlock x:Name="DialogHeading"
                       Text="Product Details"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Enter the product information below."
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,0,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,15">
                    <TextBlock Text="Product Name *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameTextBox" Style="{StaticResource ProductTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,15">
                    <TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SkuTextBox" Style="{StaticResource ProductTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,15">
                    <TextBlock Text="Cost Price" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CostPriceTextBox" Style="{StaticResource ProductTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,15">
                    <TextBlock Text="Selling Price" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SellingPriceTextBox" Style="{StaticResource ProductTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,15">
                    <TextBlock Text="Stock Quantity" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StockQuantityTextBox" Style="{StaticResource ProductTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,15">
                    <TextBlock Text="Reorder Level" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ReorderLevelTextBox" Style="{StaticResource ProductTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,15">
                    <TextBlock Text="Brand *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="BrandComboBox"
                              Height="38"
                              Padding="8,5"
                              ItemsSource="{Binding Brands}"
                              DisplayMemberPath="BrandName"
                              SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                              SelectedValuePath="BrandId"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,15">
                    <TextBlock Text="Category *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CategoryComboBox"
                              Height="38"
                              Padding="8,5"
                              ItemsSource="{Binding Categories}"
                              DisplayMemberPath="CategoryName"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              SelectedValuePath="CategoryId"/>
                </StackPanel>

                <CheckBox Grid.Row="4"
                          Grid.ColumnSpan="2"
                          x:Name="ActiveCheckBox"
                          Content="Active product"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,0,18"/>
            </Grid>

            <TextBlock x:Name="ValidationMessage"
                       Foreground="#DC2626"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="#F1F5F9"
                        Foreground="#475569"
                        BorderThickness="0"
                        Click="CancelButton_Click"/>

                <Button Content="Save Product"
                        Width="130"
                        Height="38"
                        Background="#0D9488"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>