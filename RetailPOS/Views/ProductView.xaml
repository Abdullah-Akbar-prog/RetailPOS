<UserControl x:Class="RetailPOS.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#0D9488"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5EAF2"/>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="ProductTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="ProductComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="InventoryGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EDF1F5"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="26">

            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Product Management"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Manage products, prices, stock levels and categories."
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#E6F6F3"
                        CornerRadius="9"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="Inventory"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#0F766E"/>
                </Border>
            </Grid>

            <!-- Product Form Card -->
            <Border Background="White"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,0,0,22"
                    BorderBrush="#E5EAF2"
                    BorderThickness="1">

                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Product Details"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Enter the product information below."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Form Fields -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Product Name -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,12,16">
                            <TextBlock Text="Product Name *"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductTextBox}"
                                     ToolTip="Enter product name"/>
                        </StackPanel>

                        <!-- SKU -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="12,0,0,16">
                            <TextBlock Text="SKU"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductTextBox}"
                                     ToolTip="Enter stock keeping unit"/>
                        </StackPanel>

                        <!-- Cost Price -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,12,16">
                            <TextBlock Text="Cost Price"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductTextBox}"/>
                        </StackPanel>

                        <!-- Selling Price -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="12,0,0,16">
                            <TextBlock Text="Selling Price"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductTextBox}"/>
                        </StackPanel>

                        <!-- Stock -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,12,16">
                            <TextBlock Text="Stock Quantity"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductTextBox}"/>
                        </StackPanel>

                        <!-- Reorder -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="12,0,0,16">
                            <TextBlock Text="Reorder Level"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductTextBox}"/>
                        </StackPanel>

                        <!-- Brand -->
                        <StackPanel Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,12,16">
                            <TextBlock Text="Brand *"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox ItemsSource="{Binding Brands}"
                                      SelectedItem="{Binding SelectedBrand}"
                                      DisplayMemberPath="BrandName"
                                      Style="{StaticResource ProductComboBox}"
                                      ToolTip="Select a brand"
                                      IsEditable="True"
                                      IsReadOnly="True"
                                      Text="Select the Brand"
                                      IsTextSearchEnabled="False" />
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="12,0,0,16">
                            <TextBlock Text="Category *"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="CategoryName"
                                      Style="{StaticResource ProductComboBox}"
                                      ToolTip="Select a category"/>
                        </StackPanel>
                    </Grid>

                    <!-- Active Product -->
                    <Border Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,18">
                        <CheckBox Content="Product is active and available for sale"
                                  IsChecked="{Binding IsActive}"
                                  Foreground="#334155"
                                  FontSize="12"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Action Buttons -->
                    <WrapPanel>
                        <Button Content="Save Product"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#0D9488"
                                Foreground="White"/>

                        <Button Content="Edit Selected"
                                Command="{Binding EditCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#E8F0FE"
                                Foreground="#2563EB"/>

                        <Button Content="Delete Selected"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#FEF2F2"
                                Foreground="#DC2626"/>

                        <Button Content="Clear Form"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#F1F5F9"
                                Foreground="#475569"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Inventory Table Card -->
            <Border Background="White"
                    CornerRadius="14"
                    Padding="20"
                    BorderBrush="#E5EAF2"
                    BorderThickness="1">

                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Product Inventory"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Select a product to edit or delete it."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False"
                              Style="{StaticResource InventoryGrid}"
                              MinHeight="280"
                              MaxHeight="440"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              AlternationCount="2">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E5EAF2"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="55"/>

                            <DataGridTextColumn Header="PRODUCT"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="130"/>

                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding SKU}"
                                                Width="100"/>

                            <DataGridTextColumn Header="BRAND"
                                                Binding="{Binding Brand.BrandName}"
                                                Width="110"/>

                            <DataGridTextColumn Header="CATEGORY"
                                                Binding="{Binding Category.CategoryName}"
                                                Width="115"/>

                            <DataGridTextColumn Header="COST"
                                                Binding="{Binding CostPrice, StringFormat={}{0:N2}}"
                                                Width="90"/>

                            <DataGridTextColumn Header="SELLING PRICE"
                                                Binding="{Binding SellingPrice, StringFormat={}{0:N2}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="STOCK"
                                                Binding="{Binding StockQuantity}"
                                                Width="70"/>

                            <DataGridCheckBoxColumn Header="ACTIVE"
                                                    Binding="{Binding IsActive}"
                                                    Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
