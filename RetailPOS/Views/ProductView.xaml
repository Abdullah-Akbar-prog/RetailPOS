<UserControl x:Class="RetailPOS.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Product Management"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#202938"
                       Margin="0,0,0,20"/>

            <!-- Product Form -->
            <Border Background="White"
                    Padding="20"
                    CornerRadius="10"
                    Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Product Details"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Product Name" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="SKU" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Cost Price" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="Selling Price" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Stock Quantity" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="Reorder Level" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Brand" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Brands}"
                                      SelectedItem="{Binding SelectedBrand}"
                                      DisplayMemberPath="BrandName"
                                      Padding="6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="Category" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="CategoryName"
                                      Padding="6"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Active Product"
                              IsChecked="{Binding IsActive}"
                              Margin="0,0,0,15"/>

                    <WrapPanel>
                        <Button Content="Save Product"
                                Command="{Binding SaveCommand}"
                                Padding="18,9"
                                Margin="0,0,8,8"
                                Background="#2563EB"
                                Foreground="White"/>

                        <Button Content="Edit Selected"
                                Command="{Binding EditCommand}"
                                Padding="18,9"
                                Margin="0,0,8,8"/>

                        <Button Content="Delete Selected"
                                Command="{Binding DeleteCommand}"
                                Padding="18,9"
                                Margin="0,0,8,8"
                                Background="#DC2626"
                                Foreground="White"/>

                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Padding="18,9"
                                Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Product Table -->
            <Border Background="White"
                    Padding="15"
                    CornerRadius="10">

                <StackPanel>
                    <TextBlock Text="Product Inventory"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <DataGrid ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="250"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Product Name"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding SKU}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Brand"
                                                Binding="{Binding Brand.BrandName}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category.CategoryName}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Cost Price"
                                                Binding="{Binding CostPrice, StringFormat={}{0:N2}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Selling Price"
                                                Binding="{Binding SellingPrice, StringFormat={}{0:N2}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Stock"
                                                Binding="{Binding StockQuantity}"
                                                Width="70"/>

                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive}"
                                                    Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
