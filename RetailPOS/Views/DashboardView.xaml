<UserControl x:Class="RetailPOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">

            <TextBlock Text="Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#202938"/>

            <TextBlock Text="Overview of your store performance"
                       Foreground="#687386"
                       Margin="0,5,0,22"/>

            <UniformGrid Columns="2" Margin="0,0,0,16">

                <Border Background="White" CornerRadius="12"
                        Padding="20" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Total Products"
                                   Foreground="#687386"/>
                        <TextBlock Text="{Binding TotalProducts}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12"
                        Padding="20" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Low Stock Products"
                                   Foreground="#687386"/>
                        <TextBlock Text="{Binding LowStockProducts}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12"
                        Padding="20" Margin="0,8,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Sales"
                                   Foreground="#687386"/>
                        <TextBlock Text="{Binding TotalSales}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#7C3AED"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12"
                        Padding="20" Margin="8,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Today's Revenue"
                                   Foreground="#687386"/>
                        <TextBlock Text="{Binding TodayRevenue,
                            StringFormat={}{0:N2}}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#15803D"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="12"
                    Padding="22" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="All-Time Revenue"
                               FontSize="16"
                               Foreground="#687386"/>
                    <TextBlock Text="{Binding TotalRevenue,
                        StringFormat={}{0:N2}}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#15803D"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#DC2626"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
