<UserControl x:Class="RetailPOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F5F7FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#0D9488"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E8EDF4"/>

        <Style x:Key="StatCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CardLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- Page Heading -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Dashboard"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Here's an overview of your store performance."
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#E6F6F3"
                        CornerRadius="9"
                        Padding="13,9"
                        VerticalAlignment="Center">
                    <TextBlock Text="●  Store Overview"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#0F766E"/>
                </Border>
            </Grid>

            <!-- Summary Heading -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Business Summary"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Key inventory and sales metrics"
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Summary Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,8">

                <!-- Total Products -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="TOTAL PRODUCTS"
                                       Style="{StaticResource CardLabel}"/>

                            <TextBlock Text="{Binding TotalProducts}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       Margin="0,12,0,5"/>

                            <TextBlock Text="Products in inventory"
                                       FontSize="12"
                                       Foreground="#94A3B8"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="44" Height="44"
                                Background="#E8F0FE"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="▦"
                                       FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Low Stock -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="LOW STOCK ITEMS"
                                       Style="{StaticResource CardLabel}"/>

                            <TextBlock Text="{Binding LowStockProducts}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"
                                       Margin="0,12,0,5"/>

                            <TextBlock Text="Items needing attention"
                                       FontSize="12"
                                       Foreground="#94A3B8"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="44" Height="44"
                                Background="#FEF2F2"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="!"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Total Sales -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="TOTAL SALES"
                                       Style="{StaticResource CardLabel}"/>

                            <TextBlock Text="{Binding TotalSales}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#7C3AED"
                                       Margin="0,12,0,5"/>

                            <TextBlock Text="Recorded transactions"
                                       FontSize="12"
                                       Foreground="#94A3B8"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="44" Height="44"
                                Background="#F3E8FF"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="↗"
                                       FontSize="25"
                                       Foreground="#7C3AED"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Today's Revenue -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="TODAY'S REVENUE"
                                       Style="{StaticResource CardLabel}"/>

                            <TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:N2}}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#0D9488"
                                       Margin="0,12,0,5"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Sales recorded today"
                                       FontSize="12"
                                       Foreground="#94A3B8"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="44" Height="44"
                                Background="#E6F6F3"
                                CornerRadius="11"
                                VerticalAlignment="Top">
                            <TextBlock Text="₨"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#0D9488"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Revenue Chart Card -->
            <Border Background="White"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,4,14,18"
                    BorderBrush="#E8EDF4"
                    BorderThickness="1">

                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <StackPanel>
                            <TextBlock Text="Sales Revenue Trend"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Daily revenue over the last seven days"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#E6F6F3"
                                CornerRadius="7"
                                Padding="10,5">
                            <TextBlock Text="7 DAYS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#0F766E"/>
                        </Border>
                    </Grid>

                    <lvc:CartesianChart
                        Series="{Binding RevenueSeries}"
                        XAxes="{Binding RevenueXAxes}"
                        YAxes="{Binding RevenueYAxes}"
                        Height="280"
                        Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <!-- All-Time Revenue -->
            <Border Background="#0D9488"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,14,18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="ALL-TIME REVENUE"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFBF1"/>

                        <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N2}}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,9,0,4"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Total revenue from all recorded sales"
                                   FontSize="12"
                                   Foreground="#CCFBF1"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="56"
                            Height="56"
                            Background="#26FFFFFF"
                            CornerRadius="14"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                        <TextBlock Text="↗"
                                   FontSize="32"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#DC2626"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,14,10"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
