<UserControl x:Class="RetailPOS.Views.SaleHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6FA">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Sale History"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#202938"/>
            <TextBlock Text="Search invoices and review purchased items"
                       Foreground="#687386"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White"
                CornerRadius="10" Padding="12"
                Margin="0,0,0,15">
            <DockPanel>
                <Button Content="Reset"
                        Command="{Binding ResetSearchCommand}"
                        DockPanel.Dock="Right"
                        Padding="18,8"
                        Margin="8,0,0,0"/>

                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        DockPanel.Dock="Right"
                        Padding="18,8"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="8,0,0,0"/>

                <TextBox Text="{Binding SearchText,
                    UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         Padding="9"
                         VerticalContentAlignment="Center"
                         ToolTip="Search by invoice number"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="White"
                CornerRadius="10" Padding="12"
                Margin="0,0,0,15">
            <DataGrid ItemsSource="{Binding Sales}"
                      SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice"
                        Binding="{Binding InvoiceNumber}"
                        Width="2*"/>

                    <DataGridTextColumn Header="Date"
                        Binding="{Binding SaleDate,
                            StringFormat={}{0:dd-MMM-yyyy hh:mm tt}}"
                        Width="2*"/>

                    <DataGridTextColumn Header="Subtotal"
                        Binding="{Binding Subtotal,
                            StringFormat={}{0:N2}}"
                        Width="*"/>

                    <DataGridTextColumn Header="Discount"
                        Binding="{Binding Discount,
                            StringFormat={}{0:N2}}"
                        Width="*"/>

                    <DataGridTextColumn Header="Grand Total"
                        Binding="{Binding GrandTotal,
                            StringFormat={}{0:N2}}"
                        Width="*"/>

                    <DataGridTextColumn Header="Paid"
                        Binding="{Binding AmountPaid,
                            StringFormat={}{0:N2}}"
                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Selected Sale Items"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="4" Background="White"
                CornerRadius="10" Padding="12"
                Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding SelectedItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product"
                        Binding="{Binding ProductName}"
                        Width="2*"/>

                    <DataGridTextColumn Header="Quantity"
                        Binding="{Binding Quantity}"
                        Width="*"/>

                    <DataGridTextColumn Header="Unit Price"
                        Binding="{Binding UnitPrice,
                            StringFormat={}{0:N2}}"
                        Width="*"/>

                    <DataGridTextColumn Header="Line Total"
                        Binding="{Binding LineTotal,
                            StringFormat={}{0:N2}}"
                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   Foreground="#687386"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
