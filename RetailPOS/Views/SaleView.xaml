<UserControl x:Class="RetailPOS.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page heading -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Point of Sale"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#202938"/>
                <TextBlock Text="Create a sale and process customer payments"
                           FontSize="13"
                           Foreground="#687386"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Product selection -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Select Product"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="Name"
                                  Height="38"
                                  Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Quantity"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="8"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="+ Add to Cart"
                            Command="{Binding AddToCartCommand}"
                            Height="38"
                            Margin="0,25,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Cart -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Shopping Cart"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CartItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="38"
                              MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product"
                                Binding="{Binding ProductName}"
                                Width="2*"/>

                            <DataGridTextColumn Header="Quantity"
                                Binding="{Binding Quantity}"
                                Width="*"/>

                            <DataGridTextColumn Header="Unit Price"
                                Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                Width="*"/>

                            <DataGridTextColumn Header="Line Total"
                                Binding="{Binding LineTotal, StringFormat={}{0:N2}}"
                                Width="*"/>

                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveItemCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#DC2626"
                                                Background="Transparent"
                                                BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Totals and payment -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   Margin="0,0,10,10"/>

                        <Button Content="Clear Cart"
                                Command="{Binding ClearCartCommand}"
                                Width="120"
                                Height="36"
                                HorizontalAlignment="Left"
                                Background="#E9EDF5"
                                BorderThickness="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Subtotal,
                            StringFormat='Subtotal: {0:N2}'}"
                                   FontSize="15"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Discount"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Discount,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Padding="7"
                                 Margin="0,5,0,10"/>

                        <TextBlock Text="{Binding GrandTotal,
                            StringFormat='Grand Total: {0:N2}'}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Amount Paid"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding AmountPaid,
                            UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Padding="7"
                                 Margin="0,5,0,10"/>

                        <TextBlock Text="{Binding Change,
                            StringFormat='Change: {0:N2}'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <Button Content="Complete Sale"
                                Command="{Binding CheckoutCommand}"
                                Height="44"
                                Background="#16A34A"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
