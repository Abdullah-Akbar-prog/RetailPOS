<UserControl x:Class="RetailPOS.Views.SaleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F1F5F9"
    FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Navy" Color="#172554"/>
        <SolidColorBrush x:Key="Accent" Color="#0D9488"/>
        <SolidColorBrush x:Key="Text" Color="#1E293B"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>

        <!-- Transparent product dropdown -->
        <Style x:Key="TransparentComboBox"
               TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TextBox styling -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#0D9488"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main action buttons -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>

        <!-- Field labels -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Cart table -->
        <Style x:Key="CartGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="45"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0"
                Background="#172554"
                CornerRadius="12"
                Padding="22"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="POINT OF SALE"
                               Foreground="#99F6E4"
                               FontSize="11"
                               FontWeight="Bold"/>
                    <TextBlock Text="New Transaction"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,3"/>
                    <TextBlock Text="Select products, review your cart, and checkout."
                               Foreground="#CBD5E1"
                               FontSize="12"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#263968"
                        CornerRadius="10"
                        Padding="15,12"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="CASH REGISTER"
                                   Foreground="#CBD5E1"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Ready for sale"
                                   Foreground="#99F6E4"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Product entry -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="PRODUCT"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource TransparentComboBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="QUANTITY"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Field}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Content="+  Add to Cart"
                            Command="{Binding AddToCartCommand}"
                            Style="{StaticResource ActionButton}"
                            MinWidth="145"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cart and checkout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Cart panel -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Shopping Cart"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>
                        <TextBlock Text="Review the items in this transaction"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CartItems}"
                              Style="{StaticResource CartGrid}"
                              MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT"
                                                Binding="{Binding ProductName}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="QTY"
                                                Binding="{Binding Quantity}"
                                                Width="55"/>
                            <DataGridTextColumn Header="UNIT PRICE"
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                                Width="*"/>
                            <DataGridTextColumn Header="TOTAL"
                                                Binding="{Binding LineTotal, StringFormat={}{0:N2}}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#DC2626"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Cart subtotal"
                                       Foreground="#64748B"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Subtotal, StringFormat={}{0:N2}}"
                                       Foreground="#1E293B"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Checkout panel -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Checkout"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="Payment summary"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,4,0,20"/>

                        <TextBlock Text="Discount"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Field}"
                                 Margin="0,0,0,18"/>

                        <!-- Total -->
                        <Border Background="#F0FDFA"
                                BorderBrush="#CCFBF1"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="TOTAL TO PAY"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#0F766E"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2}}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#0F766E"
                                           Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Amount paid"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Field}"
                                 Margin="0,0,0,18"/>

                        <!-- Change due -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Change due"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Change, StringFormat={}{0:N2}}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#0D9488"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Status -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,12"/>

                        <!-- Save Sale -->
                        <Button Content="Save Sale"
                                Command="{Binding CheckoutCommand}"
                                Style="{StaticResource ActionButton}"
                                Background="#0D9488"
                                Height="50"
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"/>

                        <!-- Clear Cart -->
                        <Button Content="Clear Cart"
                                Command="{Binding ClearCartCommand}"
                                Style="{StaticResource LightButton}"
                                Height="42"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
